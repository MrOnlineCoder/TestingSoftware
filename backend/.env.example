# Password for teacher mode (required, must not be empty)
TEACHER_PASSWORD=
PORT=3000
HOST=0.0.0.0
# SQLite database file, created automatically (relative to the backend folder)
DATABASE_PATH=./data/app.db
# Optional: folder with the built frontend (e.g. ../frontend/dist). Leave empty to serve the API only.
STATIC_DIR=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
